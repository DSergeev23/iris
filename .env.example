# PostgreSQL in the Timeweb private network. Never put this value in the repository.
DATABASE_URL="postgresql://iris_app:change-me@192.168.0.4:5432/iris?schema=public"

# A long, random string, at least 32 bytes.
SESSION_SECRET="replace-with-a-random-secret"

# Timeweb S3 credentials. Bucket stays private.
S3_ENDPOINT="https://s3.twcstorage.ru"
S3_REGION="ru-1"
S3_BUCKET="your-private-bucket"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
