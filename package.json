    "db:migrate": "prisma migrate deploy",
    "db:seed": "node scripts/seed-content.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@prisma/client": "^6.16.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "argon2": "^0.41.1",
    "lucide-react": "^0.468.0",
    "next": "16.3.3",
    "prisma": "^6.16.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  }
}
