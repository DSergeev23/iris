{
  "name": "iris-care",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "npm run test:contract && npm run test:integration",
    "test:contract": "node --test tests/admin-contract.test.mjs",
    "test:integration": "node --experimental-strip-types --test tests/*.integration.test.ts",
